# OnFly OS — environment variables
# Copy to .env and fill in. Never commit .env.

# Supabase (public — safe for Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase service role — edge functions / scripts ONLY (never VITE_*)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Database password (Settings → Database) — required to apply migrations via scripts/apply-migration.ts
SUPABASE_DB_PASSWORD=
# Pooler (IPv4). Direct db.<ref>.supabase.co is often IPv6-only and unreachable from many agents.
SUPABASE_DB_HOST=aws-1-us-east-2.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres.<project-ref>

# Adapter toggles (mock | real). Ready doors default to real when keys exist.
# BLOCKED (keep mock): NOTAMs (FAA).
# COMMS: real → supabase/functions/send-sms → RingCentral (default real in prod).
# Set mock only for local phone-simulator demos without Supabase.
# QB: mock until Intuit OAuth app wired; then VITE_QB_ADAPTER=real + edge secrets.
VITE_COMMS_ADAPTER=real
# Email: real → supabase/functions/send-email → Resend
VITE_EMAIL_ADAPTER=real
# Maps: real → Mapbox Directions (VITE_MAPBOX_TOKEN pk.*)
VITE_MAPS_ADAPTER=real
# ADS-B: real → FlightAware AeroAPI via adsb-positions edge
VITE_ADSB_ADAPTER=mock
# QuickBooks: mock demo; real → quickbooks-auth/api + send-invoice-email
# Alias: VITE_ACCOUNTING_PROVIDER=quickbooks (same as real)
VITE_QB_ADAPTER=mock
# VITE_ACCOUNTING_PROVIDER=mock
# LLM: real → edge llm-extract (Claude)
VITE_LLM_ADAPTER=real
# aviationweather.gov METAR/TAF — defaults to real (no key)
VITE_WX_ADAPTER=real

# Mapbox public token (pk.*) — safe for Vite; used when VITE_MAPS_ADAPTER=real
VITE_MAPBOX_TOKEN=

# RingCentral SMS — set on Supabase (edge secrets), NOT as VITE_*
# Deploy: npm run deploy:send-sms  (or npx tsx scripts/deploy-send-sms.ts)
# JWT must belong to the extension that owns RINGCENTRAL_SMS_FROM (SmsSender).
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
RINGCENTRAL_SMS_FROM=
# Optional (default production):
# RINGCENTRAL_SERVER_URL=https://platform.ringcentral.com

# Resend — set on Supabase (edge secrets), NOT as VITE_*
# Deploy all vendor fns: npm run deploy:vendors
RESEND_API_KEY=
# Verified domain sender — OnFly uses info@onflyair.com
EMAIL_FROM=OnFly Air <info@onflyair.com>
# Dashboard → Account → Access Tokens (for deploy script)
SUPABASE_ACCESS_TOKEN=

# Anthropic Claude — preferred for llm-extract (never VITE_*)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenAI — optional fallback only (never VITE_*)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# QuickBooks (Chunk 5) — Intuit developer app OAuth (edge secrets, never VITE_*)
# Redirect: https://<project>.supabase.co/functions/v1/quickbooks-auth/callback
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_ENVIRONMENT=sandbox
QB_REDIRECT_URI=
# Branded invoice sender (Resend); BCC info@onflyair.com in send-invoice-email
INVOICE_EMAIL_FROM=OnFly Air <invoices@onflyair.com>

# Telnyx robocalls (Chunk 7) — not in vault yet
TELNYX_API_KEY=
TELNYX_FROM=

# ADS-B — prefer FlightAware AeroAPI (edge secret, never VITE_*)
FLIGHTAWARE_AEROAPI_KEY=
ADSB_PROVIDER=flightaware
# Public URL of adsb-alert-webhook (after deploy) for movement alerts
ADSB_ALERT_WEBHOOK_URL=
# Legacy RapidAPI ADSBX — do not use for new setups
ADSB_RAPIDAPI_KEY=
ADSB_API_KEY=

# Google Routes — optional; Mapbox covers drive times today
GOOGLE_MAPS_API_KEY=


# Operator invite email
# Empty onboard URL → {VITE_APP_URL}/onboard (no insured-amount field)
VITE_ONBOARD_URL=
VITE_SKYIQ_URL=https://info.skyiq.net/

# App
# Local default. On Vercel Production set the public https URL operators open
# (custom domain — NOT a Deployment-Protected *.vercel.app preview), e.g.
# https://app.onflyair.com — outbound SMS/email offer links use this.
VITE_APP_URL=http://localhost:5173
# Desk inbox for portal / intake alerts (defaults to info@onflyair.com)
VITE_DISPATCH_ALERT_EMAIL=info@onflyair.com

# ── Vercel env parity ─────────────────────────────────────────
# Preview + Production must carry the same VITE_* adapter toggles and
# Supabase/Mapbox public keys as this file (minus localhost APP_URL).
# Sync: export VERCEL_TOKEN=… && npm run sync:vercel-env
# Required on Vercel: VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY,
#   VITE_MAPBOX_TOKEN, VITE_EMAIL_ADAPTER, VITE_MAPS_ADAPTER,
#   VITE_LLM_ADAPTER, VITE_WX_ADAPTER, VITE_ADSB_ADAPTER, VITE_QB_ADAPTER,
#   VITE_COMMS_ADAPTER, VITE_APP_URL (https production URL)

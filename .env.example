# OnFly OS — environment variables
# Copy to .env and fill in. Never commit .env.

# Supabase (public — safe for Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase service role — edge functions / scripts ONLY (never VITE_*)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Database password (Settings → Database) — required to apply migrations via scripts/apply-migration.ts
SUPABASE_DB_PASSWORD=
# Pooler (IPv4). Direct db.<ref>.supabase.co is often IPv6-only and unreachable from many agents.
SUPABASE_DB_HOST=aws-1-us-east-2.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres.<project-ref>

# Adapter toggles (mock | real). App demos fully with mocks.
VITE_COMMS_ADAPTER=mock
# Email: mock logs locally; real → supabase/functions/send-email → Resend
VITE_EMAIL_ADAPTER=mock
VITE_MAPS_ADAPTER=mock
VITE_ADSB_ADAPTER=mock
VITE_QB_ADAPTER=mock
VITE_LLM_ADAPTER=mock
# aviationweather.gov METAR/TAF — defaults to real (no key)
VITE_WX_ADAPTER=real

# RingCentral (Chunk 3+)
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=
RINGCENTRAL_SMS_FROM=

# Resend — set on Supabase (edge secrets), NOT as VITE_*
# Deploy: npx tsx scripts/deploy-send-email.ts
RESEND_API_KEY=
# Verified domain sender, e.g. OnFly Air <ops@onflyair.com>
# Falls back to onboarding@resend.dev (Resend test inbox only)
EMAIL_FROM=
# Dashboard → Account → Access Tokens (for deploy script)
SUPABASE_ACCESS_TOKEN=

# QuickBooks (Chunk 5)
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REALM_ID=
QB_REDIRECT_URI=

# Telnyx robocalls (Chunk 7)
TELNYX_API_KEY=
TELNYX_FROM=

# ADS-B (Chunk 7)
ADSB_API_KEY=
ADSB_PROVIDER=

# Google Routes / Maps
GOOGLE_MAPS_API_KEY=

# Anthropic Claude (D085 parse, NOTAM plain English, tax assist, intake)
ANTHROPIC_API_KEY=
# Optional override — defaults to claude-sonnet when real
ANTHROPIC_MODEL=

# Operator invite email
# Empty onboard URL → {VITE_APP_URL}/onboard (no insured-amount field)
VITE_ONBOARD_URL=
VITE_SKYIQ_URL=https://info.skyiq.net/

# App
VITE_APP_URL=http://localhost:5173

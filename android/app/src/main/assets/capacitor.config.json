{
	"appId": "com.onflyair.client",
	"appName": "OnFly",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"ios": {
		"contentInset": "automatic",
		"backgroundColor": "#F7F2E3",
		"preferredContentMode": "mobile"
	},
	"android": {
		"backgroundColor": "#F7F2E3",
		"allowMixedContent": false
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": true,
			"backgroundColor": "#0C0C0E",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0C0C0E"
		}
	}
}
